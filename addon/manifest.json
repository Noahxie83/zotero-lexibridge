{
  "manifest_version": 2,
  "name": "Local Dictionary · 本地词典",
  "version": "1.2.1",
  "description": "Zotero 离线词典：MDX、StarDict 和 DSL，点击、划选与手动查询，词形还原、生词上下文、笔记与导出、本地发音。",
  "author": "Noahxie83",
  "icons": {
    "16": "icons/local-mdx.svg",
    "24": "icons/local-mdx.svg",
    "32": "icons/local-mdx.svg",
    "48": "icons/local-mdx.svg",
    "64": "icons/local-mdx.svg",
    "96": "icons/local-mdx.svg",
    "128": "icons/local-mdx.svg"
  },
  "applications": {
    "zotero": {
      "id": "local-mdx-click@noahx.local",
      "update_url": "https://raw.githubusercontent.com/Noahxie83/zotero-local-mdx-click/main/updates.json",
      "strict_min_version": "10.0",
      "strict_max_version": "10.0.*"
    }
  }
}
